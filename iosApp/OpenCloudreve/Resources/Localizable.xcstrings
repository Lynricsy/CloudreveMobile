          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码"
          }
        }
      }
    },
    "密码不正确": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码不正确"
          }
        }
      }
    },
    "密码至少 %lld 位": {
      "comment": "注册页密码长度要求",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least %lld characters"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码至少 %lld 位"
          }
        }
      }
    },
    "将撤销此设备上的登录凭证，账户数据保留在服务器上。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in credentials on this device will be revoked. Your data stays on the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将撤销此设备上的登录凭证，账户数据保留在服务器上。"
          }
        }
      }
    },
    "已存在同名项目": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An item with the same name already exists"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名项目"
          }
        }
