    "发生未知错误": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unknown error occurred"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生未知错误"
          }
        }
      }
    },
    "发生错误：%@": {
      "comment": "服务端或系统给出的原始错误信息",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An error occurred: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生错误：%@"
