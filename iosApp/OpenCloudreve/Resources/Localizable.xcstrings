        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld+ items"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld+ 项"
          }
        }
      }
    },
    "30 天前结束的任务": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ended over 30 days ago"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天前结束的任务"
          }
