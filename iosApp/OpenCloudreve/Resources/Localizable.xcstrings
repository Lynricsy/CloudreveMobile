    "发送重置邮件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Reset Email"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送重置邮件"
          }
        }
      }
    },
    "在浏览器中打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中打开"
          }
        }
      }
    },
    "在系统浏览器中登录此站点，可使用 Passkey 或已保存的网页会话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to this site in the system browser, using a passkey or an existing web session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统浏览器中登录此站点，可使用 Passkey 或已保存的网页会话。"
          }
        }
      }
    },
    "好": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
