      }
    },
    "我的": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Me"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的"
          }
        }
      }
    },
    "打开身份验证器应用，输入其中显示的 6 位验证码。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your authenticator app and enter the 6-digit code it shows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开身份验证器应用，输入其中显示的 6 位验证码。"
