        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务"
          }
        }
      }
    },
    "你创建的分享链接会显示在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share links you create will appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你创建的分享链接会显示在这里。"
          }
        }
      }
    },
    "你的文件和文件夹会显示在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files and folders will appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的文件和文件夹会显示在这里。"
          }
        }
      }
    },
    "使用 Passkey / 网页登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In with Passkey / Web"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Passkey / 网页登录"
          }
        }
      }
    },
    "例如 https://cloud.example.com；未填写协议时默认使用 HTTPS。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example https://cloud.example.com. HTTPS is used when no scheme is given."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如 https://cloud.example.com；未填写协议时默认使用 HTTPS。"
          }
        }
      }
    },
    "分享": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享"
          }
        }
      }
    },
