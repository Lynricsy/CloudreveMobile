{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ 分享": {
      "comment": "分享头部，参数为分享者昵称",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared by %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 分享"
          }
        }
      }
    },
    "%@ 分享了受密码保护的内容": {
      "comment": "参数为分享者昵称",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ shared password-protected content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 分享了受密码保护的内容"
          }
        }
      }
    },
    "%lld 个版本": {
      "comment": "版本保留数量",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld versions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个版本"
          }
        }
      }
    },
    "%lld 个结果": {
      "comment": "搜索结果数量",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld results"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个结果"
          }
        }
      }
    },
    "%lld 天后清除": {
      "comment": "回收站自动清除倒计时（天）",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted in %lld days"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 天后清除"
          }
        }
      }
    },
    "%lld 小时后清除": {
      "comment": "回收站自动清除倒计时（小时）",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted in %lld hours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小时后清除"
          }
        }
      }
    },
    "%lld 次下载": {
      "comment": "分享下载次数",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld downloads"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 次下载"
          }
        }
