    "服务端版本 %@": {
      "comment": "登录页显示的服务端版本号",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server version %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端版本 %@"
          }
        }
      }
    },
    "此站点的验证码需要较新的服务端（4.19.11 及以上）才能在 App 内完成，请在网页端登录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This site's captcha requires a newer server (4.19.11 or later) to complete in the app. Please sign in on the web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此站点的验证码需要较新的服务端（4.19.11 及以上）才能在 App 内完成，请在网页端登录。"
          }
        }
      }
    },
