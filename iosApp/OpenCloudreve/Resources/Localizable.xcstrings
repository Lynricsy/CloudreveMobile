{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ 分享": {
      "comment": "分享头部，参数为分享者昵称",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared by %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 分享"
          }
        }
      }
    },
    "%@ 分享了受密码保护的内容": {
      "comment": "参数为分享者昵称",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ shared password-protected content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 分享了受密码保护的内容"
          }
        }
      }
    },
