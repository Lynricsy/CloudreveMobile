-- 已登录的账户（多服务器、多用户）。令牌不入库，存放在 SecureStore。
-- id = "<user_id>@<站点地址去掉协议与尾部 />"，同一服务器同一用户重复登录会覆盖同一行。
CREATE TABLE AccountRecord (
    id TEXT NOT NULL PRIMARY KEY,
    server_url TEXT NOT NULL,
    user_id TEXT NOT NULL,
    email TEXT NOT NULL,
    nickname TEXT NOT NULL,
    avatar_version INTEGER NOT NULL DEFAULT 0,
    -- 当前选中的账户（全表至多一行为 1）
    is_active INTEGER NOT NULL DEFAULT 0,
    -- 刷新失败后标记为 1，需要重新登录
    session_expired INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

selectAll:
SELECT * FROM AccountRecord ORDER BY created_at ASC, id ASC;

selectById:
SELECT * FROM AccountRecord WHERE id = ?;

selectActive:
SELECT * FROM AccountRecord WHERE is_active = 1 LIMIT 1;

-- 登录成功：insertIfAbsent + updateLogin 在同一事务内执行（保留原 created_at 与 is_active，并清除失效标记）
insertIfAbsent:
INSERT OR IGNORE INTO AccountRecord (id, server_url, user_id, email, nickname, avatar_version, is_active, session_expired, created_at)
VALUES (:id, :server_url, :user_id, :email, :nickname, 0, 0, 0, :created_at);

updateLogin:
UPDATE AccountRecord
SET server_url = :server_url, user_id = :user_id, email = :email, nickname = :nickname, session_expired = 0
WHERE id = :id;

updateProfile:
UPDATE AccountRecord SET email = :email, nickname = :nickname WHERE id = :id;

bumpAvatarVersion:
UPDATE AccountRecord SET avatar_version = avatar_version + 1 WHERE id = ?;

clearActive:
UPDATE AccountRecord SET is_active = 0 WHERE is_active = 1;

setActive:
UPDATE AccountRecord SET is_active = 1 WHERE id = ?;

markSessionExpired:
UPDATE AccountRecord SET session_expired = 1 WHERE id = ?;

deleteById:
DELETE FROM AccountRecord WHERE id = ?;
