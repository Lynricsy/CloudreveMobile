    "Passkey 验证失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey verification failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey 验证失败"
