      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV"
          }
        }
      }
    },
    "iOS 端暂不支持直接添加 Passkey，请在网页端添加后用于登录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding passkeys isn’t supported on iOS yet. Add one on the web, then use it to sign in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 端暂不支持直接添加 Passkey，请在网页端添加后用于登录。"
          }
        }
      }
    },
    "一次最多操作 %lld 项": {
      "comment": "多选超过批量上限的提示",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to %lld items at a time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多操作 %lld 项"
          }
        }
      }
