{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "6 位验证码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6-digit code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "6 位验证码"
          }
        }
      }
    },
    "Passkey 验证失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey verification failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey 验证失败"
          }
        }
      }
    },
    "上传、下载与后台任务会显示在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads, downloads and background tasks will appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传、下载与后台任务会显示在这里。"
          }
        }
      }
    },
    "下一步": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步"
          }
        }
      }
    },
    "两次输入的密码不一致": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords do not match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次输入的密码不一致"
          }
        }
      }
