    "两步验证": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-Factor Authentication"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两步验证"
